# PostgreSQL 数据库名称
POSTGRES_DB=aml

# PostgreSQL 登录用户名
POSTGRES_USER=aml_user

# PostgreSQL 登录密码，仅用于演示
POSTGRES_PASSWORD=123456

# PostgreSQL 映射到本地开发主机的端口
POSTGRES_PORT=5432

# Redis 映射到本地开发主机的端口
REDIS_PORT=6379

# Kafka 映射到本地开发主机的端口
KAFKA_PORT=9092

# Gateway 对外提供 HTTP 接口的端口，浏览器和前端访问此端口
GATEWAY_PORT=8000

# Data Service 映射到本地开发主机的调试端口
DATA_SERVICE_PORT=8001

# Model Service 映射到本地开发主机的调试端口
MODEL_SERVICE_PORT=8002

# Web 前端端口
WEB_PORT=8080

# 当前模型的版本标识，会写入预测结果
MODEL_VERSION=aml-model-v1